//=============================================================================
// Vector Float Instructions as Xenon Computes Them
//
// The VMX instructions whose plain SSE form gives other bits than the Xbox 360,
// with the rules xenia-canary's hardware-recorded tests show (ReIGlue 0400 to
// 0402):
//
// - vmaddfp and vnmsubfp (and vmaddfp128, vmaddcfp128, vnmsubfp128) round once:
//   the product is not rounded before the add. Built with FMA (-mfma,
//   /arch:AVX2, ARM64) that is the fused instruction. Otherwise it is the FMA
//   instruction on a CPU that has it (the check and REX_PPC_FMA of ppc_fma
//   above), and on one without, or with REX_PPC_FMA=0, a multiply, then an add,
//   as before ReIGlue 0400. That is two roundings, and the difference from the
//   console is not only in the last bit: a product that underflows is flushed
//   to a signed zero before the add (a tiny negative product plus +0 comes out
//   +0 where the console gives -0), a sum that cancels magnifies the product's rounding (5 to 8
//   units in the last place in xenia-canary's recorded cases), and a product
//   that overflows float32 gives an infinity or a NaN the single rounding does
//   not (FLT_MAX * 2 - FLT_MAX). 588 of its 15,600 recorded vmaddfp cases and
//   300 of its 15,600 vnmsubfp cases come out different that way.
//   REX_PPC_FMA=1 on such a CPU asks for the single rounding through std::fma
//   per lane, many times slower. ppc_vfma_single_rounding() says whether the
//   rounding is single (the PPC tests skip the cases that need it when not).
// - vnmsubfp negates every result but a NaN: -(a * c - b), so an exact zero
//   comes out as -0.
// - A NaN result is the first NaN operand in the order vA, vB (the addend),
//   vC, quieted; a NaN from an invalid operation (infinity times zero,
//   infinity minus infinity) is 0x7FC00000. x86 gives 0xFFC00000 there and
//   picks a NaN operand by position, so NaN lanes are redone in a cold branch.
// - vmaxfp, vminfp, vmsum3fp128 and vmsum4fp128: below.
//=============================================================================

#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)
#include <simde/x86/fma.h>
#endif

// The lanes of r that are NaN: the first NaN of a, b, c (quieted), or the
// default QNaN when none is (an invalid operation). Inlined into each site's
// [[unlikely]] branch: a call there would be opaque to the compiler, which would
// then reload and store again, around every site, the guest registers it keeps
// in host registers, even when the branch is not taken.
[[gnu::always_inline]] inline simde__m128 ppc_vnan3(simde__m128 r, simde__m128 a, simde__m128 b,
                                                    simde__m128 c) {
  const simde__m128 quiet = simde_mm_castsi128_ps(simde_mm_set1_epi32(0x00400000));
  simde__m128 nan = simde_mm_castsi128_ps(simde_mm_set1_epi32(0x7FC00000));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(c, quiet), simde_mm_cmpunord_ps(c, c));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(b, quiet), simde_mm_cmpunord_ps(b, b));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(a, quiet), simde_mm_cmpunord_ps(a, a));
  return simde_mm_blendv_ps(r, nan, simde_mm_cmpunord_ps(r, r));
}

inline bool ppc_vany_nan(simde__m128 r) {
  return simde_mm_movemask_ps(simde_mm_cmpunord_ps(r, r)) != 0;
}

#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)

inline simde__m128 ppc_vfma(simde__m128 a, simde__m128 c, simde__m128 b) {
  return simde_mm_fmadd_ps(a, c, b);
}

// a * c - b is a * c + (-b), exactly (simde's fmsub is not fused on ARM64).
inline simde__m128 ppc_vfms(simde__m128 a, simde__m128 c, simde__m128 b) {
  return simde_mm_fmadd_ps(
      a, c, simde_mm_xor_ps(b, simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)))));
}

inline bool ppc_vfma_single_rounding() {
  return true;
}

#else

// The FMA instructions are in inline assembly because the code is not built
// for them. ppc_vfma_mode: 1 when the CPU and the OS have FMA (and REX_PPC_FMA
// is not 0), 0 for the multiply and the add, 2 when REX_PPC_FMA=1 asks for the
// single rounding on a CPU without FMA (std::fma per lane, slow). The empty
// asm keeps the compiler from contracting the multiply and the add.
inline const int ppc_vfma_mode = !ppc_host_has_fma ? 0 : ppc_detect_host_fma() ? 1 : 2;

inline bool ppc_vfma_single_rounding() {
  return ppc_vfma_mode != 0;
}

// Reads nothing but its arguments ([[gnu::const]]), so the call costs the sites
// nothing while the mode is not 2.
[[gnu::noinline, gnu::cold, gnu::const]] inline simde__m128 ppc_vfma_soft(simde__m128 a,
                                                                        simde__m128 c,
                                                                        simde__m128 b) {
  alignas(16) float av[4], cv[4], bv[4];
  simde_mm_store_ps(av, a);
  simde_mm_store_ps(cv, c);
  simde_mm_store_ps(bv, b);
  for (int i = 0; i < 4; i++) {
    av[i] = std::fma(av[i], cv[i], bv[i]);
  }
  return simde_mm_load_ps(av);
}

// One test of the mode per site; the compiler loads the mode once for a run of
// sites. Mode 1 is tested first, unhinted: on a game block of 12 vmaddfp (Zen 4)
// that was within a few percent of the best layout for each of modes 0 and 1.
inline simde__m128 ppc_vfma(simde__m128 a, simde__m128 c, simde__m128 b) {
#if defined(__x86_64__) || defined(_M_X64)
  const int mode = ppc_vfma_mode;
  if (mode == 1) {
    __asm__("vfmadd213ps %2, %1, %0" : "+x"(a) : "x"(c), "x"(b));
    return a;
  }
  if (mode == 2) [[unlikely]] {
    return ppc_vfma_soft(a, c, b);
  }
  simde__m128 product = simde_mm_mul_ps(a, c);
  __asm__("" : "+x"(product));
  return simde_mm_add_ps(product, b);
#else
  return simde_mm_fmadd_ps(a, c, b);
#endif
}

inline simde__m128 ppc_vfms(simde__m128 a, simde__m128 c, simde__m128 b) {
#if defined(__x86_64__) || defined(_M_X64)
  const int mode = ppc_vfma_mode;
  if (mode == 1) {
    __asm__("vfmsub213ps %2, %1, %0" : "+x"(a) : "x"(c), "x"(b));
    return a;
  }
  if (mode == 2) [[unlikely]] {
    const simde__m128 sign = simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)));
    return ppc_vfma_soft(a, c, simde_mm_xor_ps(b, sign));
  }
  simde__m128 product = simde_mm_mul_ps(a, c);
  __asm__("" : "+x"(product));
  return simde_mm_sub_ps(product, b);
#else
  return simde_mm_fmadd_ps(
      a, c, simde_mm_xor_ps(b, simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)))));
#endif
}

#endif

// vmaddfp vD, vA, vC, vB: vD = vA * vC + vB.
inline simde__m128 ppc_vmaddfp(simde__m128 a, simde__m128 c, simde__m128 b) {
  simde__m128 r = ppc_vfma(a, c, b);
  if (ppc_vany_nan(r)) [[unlikely]] {
    r = ppc_vnan3(r, a, b, c);
  }
  return r;
}

// vnmsubfp vD, vA, vC, vB: vD = -(vA * vC - vB); the sign flip skips NaNs.
inline simde__m128 ppc_vnmsubfp(simde__m128 a, simde__m128 c, simde__m128 b) {
  simde__m128 r = simde_mm_xor_ps(ppc_vfms(a, c, b),
                                  simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000))));
  if (ppc_vany_nan(r)) [[unlikely]] {
    r = ppc_vnan3(r, a, b, c);
  }
  return r;
}

// vmaxfp and vminfp (and the VMX128 forms): a denormal is a signed zero, a NaN
// operand is the result (vA first, quieted), and between zeros the maximum is
// -0 only when both are, the minimum +0 only when both are. SSE's max and min
// give the second operand for a NaN and for equal values, and a denormal's
// bits. The equal values take the AND (maximum) or the OR (minimum) of the two,
// which is the right zero, and a denormal result becomes its signed zero, with
// or without DAZ (which makes the compare see denormals as zeros).
inline simde__m128 ppc_vflush(simde__m128 x) {
  const simde__m128i bits = simde_mm_castps_si128(x);
  const simde__m128i tiny = simde_mm_cmpeq_epi32(
      simde_mm_and_si128(bits, simde_mm_set1_epi32(0x7F800000)), simde_mm_setzero_si128());
  return simde_mm_castsi128_ps(
      simde_mm_andnot_si128(simde_mm_and_si128(tiny, simde_mm_set1_epi32(0x7FFFFFFF)), bits));
}

// The lanes where a or b is a NaN: a quieted if it is one, else b quieted
// (inlined into the [[unlikely]] branch, as ppc_vnan3).
[[gnu::always_inline]] inline simde__m128 ppc_vnan2(simde__m128 r, simde__m128 a, simde__m128 b) {
  const simde__m128 quiet = simde_mm_castsi128_ps(simde_mm_set1_epi32(0x00400000));
  const simde__m128 nan = simde_mm_blendv_ps(simde_mm_or_ps(b, quiet), simde_mm_or_ps(a, quiet),
                                             simde_mm_cmpunord_ps(a, a));
  return simde_mm_blendv_ps(r, nan, simde_mm_cmpunord_ps(a, b));
}

inline simde__m128 ppc_vmaxfp(simde__m128 a, simde__m128 b) {
  simde__m128 r = ppc_vflush(simde_mm_blendv_ps(simde_mm_max_ps(a, b), simde_mm_and_ps(a, b),
                                                simde_mm_cmpeq_ps(a, b)));
  if (simde_mm_movemask_ps(simde_mm_cmpunord_ps(a, b)) != 0) [[unlikely]] {
    r = ppc_vnan2(r, a, b);
  }
  return r;
}

inline simde__m128 ppc_vminfp(simde__m128 a, simde__m128 b) {
  simde__m128 r = ppc_vflush(simde_mm_blendv_ps(simde_mm_min_ps(a, b), simde_mm_or_ps(a, b),
                                                simde_mm_cmpeq_ps(a, b)));
  if (simde_mm_movemask_ps(simde_mm_cmpunord_ps(a, b)) != 0) [[unlikely]] {
    r = ppc_vnan2(r, a, b);
  }
  return r;
}

// vmsum3fp128 and vmsum4fp128: each product of two floats is exact in float64,
// summed in the order Xenia's x64 backend uses and matched to the console
// (DOT_PRODUCT_3/4), (x + z) + y or (x + z) + (y + w): each sum rounded to
// float64, the total rounded once to float32, to nearest, in all four lanes.
// Guest x, y, z and w are host lanes 3, 2, 1 and 0. As in Xenia, denormal
// inputs and a denormal result are zeros through the flush mode the generated
// code sets before every vector float instruction (DAZ and FTZ on x86, FZ on
// ARM64). The narrowing is a plain conversion (cvtsd2ss, fcvt): simde's
// cvtsd_ss is fcvtxn on ARM64, which rounds to odd and never overflows.
//
// A result that is not finite is redone from the inputs by ppc_vmsum_special,
// in the order of Xenia's sequence, so that it does not depend on the host or
// on the order the compiler gives the commutative operations: the first NaN
// operand of each step goes through, quieted (vA's before vB's in a product, x
// before z, (x + z) before y or (y + w), y before w); a NaN a step makes
// (infinity times zero, infinity minus infinity) is Xenon's default QNaN
// 0x7FC00000, as its invalid operations give in xenia-canary's recorded
// vrsqrtefp cases (x86 makes 0xFFC00000); finite inputs that overflow float32
// give 0x7FC00000 too (0025), and an infinity from the inputs is kept. The
// common path has one branch, on the narrowed result, and no general-purpose
// register round trip for the result.
[[gnu::noinline, gnu::cold, gnu::const]] inline uint32_t ppc_vmsum_special(simde__m128 a,
                                                                         simde__m128 b,
                                                                         bool four) {
  alignas(16) uint32_t av[4], bv[4];
  simde_mm_store_si128(reinterpret_cast<simde__m128i*>(av), simde_mm_castps_si128(a));
  simde_mm_store_si128(reinterpret_cast<simde__m128i*>(bv), simde_mm_castps_si128(b));
  struct Term {
    double value;
    uint32_t nan;  // the result's bits when it is a NaN, else 0
  };
  const auto is_nan = [](uint32_t x) { return (x & 0x7FFFFFFFu) > 0x7F800000u; };
  const auto value = [](uint32_t x) {
    if ((x & 0x7F800000u) == 0) {
      x &= 0x80000000u;  // a denormal input is a signed zero
    }
    return double(std::bit_cast<float>(x));
  };
  const auto product = [&](int lane) -> Term {
    if (is_nan(av[lane])) {
      return {0.0, av[lane] | 0x00400000u};
    }
    if (is_nan(bv[lane])) {
      return {0.0, bv[lane] | 0x00400000u};
    }
    const double p = value(av[lane]) * value(bv[lane]);
    return p != p ? Term{0.0, 0x7FC00000u} : Term{p, 0};
  };
  const auto add = [](Term x, Term y) -> Term {
    if (x.nan) {
      return x;
    }
    if (y.nan) {
      return y;
    }
    const double s = x.value + y.value;
    return s != s ? Term{0.0, 0x7FC00000u} : Term{s, 0};
  };
  const Term xz = add(product(3), product(1));
  const Term total = four ? add(xz, add(product(2), product(0))) : add(xz, product(2));
  if (total.nan) {
    return total.nan;
  }
  const float narrow = float(total.value);
  if (std::isinf(narrow) && std::isfinite(total.value)) {
    return 0x7FC00000u;
  }
  return std::bit_cast<uint32_t>(narrow);
}

inline simde__m128d ppc_vmsum_pairs(simde__m128 a, simde__m128 b, simde__m128d& yx) {
  const simde__m128d wz = simde_mm_mul_pd(simde_mm_cvtps_pd(a), simde_mm_cvtps_pd(b));
  yx = simde_mm_mul_pd(simde_mm_cvtps_pd(simde_mm_movehl_ps(a, a)),
                       simde_mm_cvtps_pd(simde_mm_movehl_ps(b, b)));
  return simde_mm_add_pd(yx, wz);  // {y + w, x + z}
}

inline simde__m128 ppc_vmsum_result(simde__m128d sum, simde__m128 a, simde__m128 b, bool four) {
  const float narrow = float(simde_mm_cvtsd_f64(sum));
  if ((std::bit_cast<uint32_t>(narrow) << 1) >= 0xFF000000u) [[unlikely]] {
    return simde_mm_castsi128_ps(simde_mm_set1_epi32(int(ppc_vmsum_special(a, b, four))));
  }
  return simde_mm_set1_ps(narrow);
}

inline simde__m128 ppc_vmsum3fp128(simde__m128 a, simde__m128 b) {
  simde__m128d yx;
  const simde__m128d pairs = ppc_vmsum_pairs(a, b, yx);
  return ppc_vmsum_result(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), yx), a, b, false);
}

inline simde__m128 ppc_vmsum4fp128(simde__m128 a, simde__m128 b) {
  simde__m128d yx;
  const simde__m128d pairs = ppc_vmsum_pairs(a, b, yx);
  return ppc_vmsum_result(simde_mm_add_sd(simde_mm_unpackhi_pd(pairs, pairs), pairs), a, b, true);
}
