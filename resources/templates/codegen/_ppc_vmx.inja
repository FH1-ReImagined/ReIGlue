//=============================================================================
// Vector Float Instructions as Xenon Computes Them
//
// The VMX instructions whose plain SSE form gives other bits than the Xbox 360,
// with the rules xenia-canary's hardware-recorded tests show (ReIGlue 0400):
//
// - vmaddfp and vnmsubfp (and vmaddfp128, vmaddcfp128, vnmsubfp128) round once:
//   the product is not rounded before the add. Built with FMA (-mfma,
//   /arch:AVX2, ARM64) that is the fused instruction. Otherwise it is the FMA
//   instruction on a CPU that has it (the check and REX_PPC_FMA of ppc_fma
//   above) and a multiply, then an add, on one without, which may differ from
//   the hardware in the last bit.
// - vnmsubfp negates every result but a NaN: -(a * c - b), so an exact zero
//   comes out as -0.
// - A NaN result is the first NaN operand in the order vA, vB (the addend),
//   vC, quieted; a NaN from an invalid operation (infinity times zero,
//   infinity minus infinity) is 0x7FC00000. x86 gives 0xFFC00000 there and
//   picks a NaN operand by position, so NaN lanes are redone out of line.
//=============================================================================

#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)
#include <simde/x86/fma.h>
#endif

// The lanes of r that are NaN: the first NaN of a, b, c (quieted), or the
// default QNaN when none is (an invalid operation).
[[gnu::noinline, gnu::cold]] inline simde__m128 ppc_vnan3(simde__m128 r, simde__m128 a,
                                                        simde__m128 b, simde__m128 c) {
  const simde__m128 quiet = simde_mm_castsi128_ps(simde_mm_set1_epi32(0x00400000));
  simde__m128 nan = simde_mm_castsi128_ps(simde_mm_set1_epi32(0x7FC00000));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(c, quiet), simde_mm_cmpunord_ps(c, c));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(b, quiet), simde_mm_cmpunord_ps(b, b));
  nan = simde_mm_blendv_ps(nan, simde_mm_or_ps(a, quiet), simde_mm_cmpunord_ps(a, a));
  return simde_mm_blendv_ps(r, nan, simde_mm_cmpunord_ps(r, r));
}

inline bool ppc_vany_nan(simde__m128 r) {
  return simde_mm_movemask_ps(simde_mm_cmpunord_ps(r, r)) != 0;
}

#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)

inline simde__m128 ppc_vfma(simde__m128 a, simde__m128 c, simde__m128 b) {
  return simde_mm_fmadd_ps(a, c, b);
}

// a * c - b is a * c + (-b), exactly (simde's fmsub is not fused on ARM64).
inline simde__m128 ppc_vfms(simde__m128 a, simde__m128 c, simde__m128 b) {
  return simde_mm_fmadd_ps(
      a, c, simde_mm_xor_ps(b, simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)))));
}

#else

// The FMA instructions are in inline assembly because the code is not built
// for them. ppc_vfma_mode: 1 when the CPU and the OS have FMA (and REX_PPC_FMA
// is not 0), 0 for the multiply and the add, 2 when REX_PPC_FMA=1 asks for the
// single rounding on a CPU without FMA (std::fma per lane, slow). The empty
// asm keeps the compiler from contracting the multiply and the add.
inline const int ppc_vfma_mode = !ppc_host_has_fma ? 0 : ppc_detect_host_fma() ? 1 : 2;

[[gnu::noinline, gnu::cold]] inline simde__m128 ppc_vfma_soft(simde__m128 a, simde__m128 c,
                                                            simde__m128 b) {
  alignas(16) float av[4], cv[4], bv[4];
  simde_mm_store_ps(av, a);
  simde_mm_store_ps(cv, c);
  simde_mm_store_ps(bv, b);
  for (int i = 0; i < 4; i++) {
    av[i] = std::fma(av[i], cv[i], bv[i]);
  }
  return simde_mm_load_ps(av);
}

inline simde__m128 ppc_vfma(simde__m128 a, simde__m128 c, simde__m128 b) {
#if defined(__x86_64__) || defined(_M_X64)
  if (ppc_vfma_mode == 1) [[likely]] {
    __asm__("vfmadd213ps %2, %1, %0" : "+x"(a) : "x"(c), "x"(b));
    return a;
  }
  if (ppc_vfma_mode == 2) [[unlikely]] {
    return ppc_vfma_soft(a, c, b);
  }
  simde__m128 product = simde_mm_mul_ps(a, c);
  __asm__("" : "+x"(product));
  return simde_mm_add_ps(product, b);
#else
  return simde_mm_fmadd_ps(a, c, b);
#endif
}

inline simde__m128 ppc_vfms(simde__m128 a, simde__m128 c, simde__m128 b) {
#if defined(__x86_64__) || defined(_M_X64)
  if (ppc_vfma_mode == 1) [[likely]] {
    __asm__("vfmsub213ps %2, %1, %0" : "+x"(a) : "x"(c), "x"(b));
    return a;
  }
  if (ppc_vfma_mode == 2) [[unlikely]] {
    const simde__m128 sign = simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)));
    return ppc_vfma_soft(a, c, simde_mm_xor_ps(b, sign));
  }
  simde__m128 product = simde_mm_mul_ps(a, c);
  __asm__("" : "+x"(product));
  return simde_mm_sub_ps(product, b);
#else
  return simde_mm_fmadd_ps(
      a, c, simde_mm_xor_ps(b, simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000)))));
#endif
}

#endif

// vmaddfp vD, vA, vC, vB: vD = vA * vC + vB.
inline simde__m128 ppc_vmaddfp(simde__m128 a, simde__m128 c, simde__m128 b) {
  simde__m128 r = ppc_vfma(a, c, b);
  if (ppc_vany_nan(r)) [[unlikely]] {
    r = ppc_vnan3(r, a, b, c);
  }
  return r;
}

// vnmsubfp vD, vA, vC, vB: vD = -(vA * vC - vB); the sign flip skips NaNs.
inline simde__m128 ppc_vnmsubfp(simde__m128 a, simde__m128 c, simde__m128 b) {
  simde__m128 r = simde_mm_xor_ps(ppc_vfms(a, c, b),
                                  simde_mm_castsi128_ps(simde_mm_set1_epi32(int(0x80000000))));
  if (ppc_vany_nan(r)) [[unlikely]] {
    r = ppc_vnan3(r, a, b, c);
  }
  return r;
}
