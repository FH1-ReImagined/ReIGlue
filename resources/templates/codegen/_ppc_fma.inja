//=============================================================================
// Multiply-Add
//
// fmadd, fmsub, fnmadd, fnmsub and their single forms call ppc_fma. Built with
// FMA (-mfma, /arch:AVX2, ARM64) it is the fused instruction, inline. Otherwise
// std::fma is a library call: a few nanoseconds on a CPU with FMA, but on one
// without (Intel before Haswell, AMD before Piledriver) a software emulation of
// the single rounding, about 30 ns a call in the Windows CRT, and games make
// tens of millions of these calls a second. On such CPUs ppc_fma multiplies,
// rounds and adds instead: the result may differ from the fused one in the
// last bit. REX_PPC_FMA=0 forces the multiply-add, REX_PPC_FMA=1 std::fma
// (read once at startup).
//=============================================================================

#include <cmath>
#include <cstdlib>

#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)

inline double ppc_fma(double a, double b, double c) { return __builtin_fma(a, b, c); }

#else

// CPUID leaf 1: FMA (ECX bit 12), and OSXSAVE (bit 27) for XGETBV, whose XCR0
// bits 1-2 say the OS saves the SSE and AVX registers.
inline bool ppc_detect_host_fma() {
#if defined(__x86_64__) || defined(_M_X64)
  unsigned int eax, ebx, ecx, edx;
  __asm__("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1u), "c"(0u));
  if ((ecx & (1u << 12)) == 0 || (ecx & (1u << 27)) == 0) {
    return false;
  }
  unsigned int xcr0_low, xcr0_high;
  __asm__("xgetbv" : "=a"(xcr0_low), "=d"(xcr0_high) : "c"(0u));
  return (xcr0_low & 6u) == 6u;
#else
  return true;
#endif
}

inline bool ppc_init_host_fma() {
  char value[8] = {};
#if defined(_WIN32)
  size_t length = 0;
  if (getenv_s(&length, value, sizeof(value), "REX_PPC_FMA") != 0) {
    value[0] = '\0';
  }
#else
  if (const char* env = std::getenv("REX_PPC_FMA")) {
    value[0] = env[0];
  }
#endif
  if (value[0] == '0') {
    return false;
  }
  if (value[0] == '1') {
    return true;
  }
  return ppc_detect_host_fma();
}

inline const bool ppc_host_has_fma = ppc_init_host_fma();

// Two roundings. The empty asm makes the rounded product an opaque value, so
// the compiler cannot contract a * b + c into an fma, not even under
// -ffp-contract=fast (which ignores the contract pragma).
inline double ppc_mul_add(double a, double b, double c) {
  double product = a * b;
#if defined(__x86_64__) || defined(_M_X64)
  __asm__("" : "+x"(product));
#endif
  return product + c;
}

inline double ppc_fma(double a, double b, double c) {
  if (ppc_host_has_fma) {
    return std::fma(a, b, c);
  }
  return ppc_mul_add(a, b, c);
}

#endif
